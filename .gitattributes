# Always LF in the repo and working tree, so files work in WSL/Linux (ROS2) as well as on Windows
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert
*.png binary
*.jpg binary
*.mp4 binary
*.pt binary
*.onnx binary
*.engine binary
