<?xml version="1.0"?>
<package format="3">
  <name>perception_ros</name>
  <version>0.1.0</version>
  <description>ROS2 nodes wrapping the perception pipeline and the CARLA bridge</description>
  <maintainer email="kumardileep1969@gmail.com">Karthik Dileep</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>perception_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
